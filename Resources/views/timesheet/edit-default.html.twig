{% block timesheet_form %}
    {% form_theme form 'form/horizontal.html.twig' %}
    {% embed formOptions.template with formOptions %}
        {% block form_body %}
            {% if form.begin_date is defined %}
                <div class="mb-3 row">
                    <label class="col-form-label col-sm-2 required" for="{{ form.vars.name }}_begin_date">{{ (form.begin_time is defined ? 'begin' : 'date')|trans }}</label>
                    <div class="col-sm-{{ form.begin_time is defined ? 5 : 10 }}">
                        {{ form_widget(form.begin_date, {'label': false}) }}
                        {{ form_errors(form.begin_date, {'label': false}) }}
                    </div>
                    {% if form.begin_time is defined %}
                    <div class="col-sm-5">
                        {{ form_widget(form.begin_time, {'label': false}) }}
                        {{ form_errors(form.begin_time, {'label': false}) }}
                    </div>
                    {% endif %}
                </div>
            {% endif %}
            {% if form.end_time is defined or form.duration is defined %}
                <div class="mb-3 row">
                    <label class="col-form-label col-sm-2" for="{{ form.vars.name }}_duration">
                        {% if form.duration is defined %}
                            {{ 'duration'|trans }}
                            {% if form.end_time is defined %} / {% endif %}
                        {% endif %}
                        {% if form.end_time is defined %}
                            {{ 'endtime'|trans }}
                        {% endif %}
                    </label>
                    {% set size = form.duration is defined and form.end_time is defined ? 5 : 10 %}
                    {% if form.duration is defined %}
                    <div class="col-sm-{{ size }}">
                        {{ form_widget(form.duration, {'label': false}) }}
                        {{ form_errors(form.duration, {'label': false}) }}
                    </div>
                    {% endif %}
                    {% if form.end_time is defined %}
                    <div class="col-sm-{{ size }}">
                        {{ form_widget(form.end_time, {'label': false}) }}
                        {{ form_errors(form.end_time, {'label': false}) }}
                    </div>
                    {% endif %}
                </div>
            {% else %}
                {% if form.duration is defined %}
                    {{ form_row(form.duration, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.duration.vars.name}}) }}
                {% endif %}
            {% endif %}

            {% if form.break is defined %}
                {{ form_row(form.break, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.break.vars.name}}) }}
            {% endif %}
            {% if form.customer is defined and form.project is defined and form.activity is defined and form.vars.data.id is null %}
                {% set happinessCombinations = happiness_common_combinations(form.vars.data.user) %}
                {% if happinessCombinations is not empty %}
                    <style>
                        .happiness-combination { max-width: calc((100% - 1rem) / 3); text-align: left; line-height: 1.25; }
                        .happiness-combination-text { display: block; min-width: 0; font-size: .75em; }
                        .happiness-combination-customer { margin-bottom: .2rem; opacity: .85; }
                    </style>
                    <div class="mb-3 row happiness-combinations"
                         data-customer="{{ form.customer.vars.id }}"
                         data-project="{{ form.project.vars.id }}"
                         data-activity="{{ form.activity.vars.id }}">
                        <label class="col-form-label col-sm-2">{{ 'happiness.suggestions.title'|trans({}, 'happiness') }}</label>
                        <div class="col-sm-10 d-flex flex-wrap gap-2 align-items-center">
                            {% for combination in happinessCombinations %}
                                <button type="button" class="btn btn-sm btn-outline happiness-combination"
                                        data-customer="{{ combination.project.customer.id }}"
                                        data-project="{{ combination.project.id }}"
                                        data-activity="{{ combination.activity.id }}"
                                        title="{{ combination.project.customer.name }} &rsaquo; {{ combination.project.name }} &rsaquo; {{ combination.activity.name }}">
                                    <span class="happiness-combination-text">
                                        <span class="happiness-combination-customer d-block text-truncate">{{ combination.project.customer.name }}</span>
                                        <span class="d-block text-truncate">{{ combination.project.name }} &rsaquo; {{ combination.activity.name }}</span>
                                    </span>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                    <script type="text/javascript">
                        (function () {
                            const modal = document.getElementById('remote_form_modal') || document;
                            const box = modal.querySelector('.happiness-combinations');
                            if (box === null) {
                                return;
                            }
                            const selects = ['customer', 'project', 'activity'].map((key) => document.getElementById(box.dataset[key]));
                            if (selects.some((select) => select === null)) {
                                return;
                            }

                            // Each select reloads the next one via the API and dispatches "data-reloaded" when done,
                            // so the values have to be applied one after the other.
                            const apply = (values, index, reloadPending) => {
                                const select = selects[index];
                                const equal = select.value === values[index];
                                if (index === selects.length - 1) {
                                    if (!equal) {
                                        select.tomselect !== undefined ? select.tomselect.setValue(values[index]) : (select.value = values[index]);
                                    }
                                    return;
                                }
                                if (equal && !reloadPending) {
                                    apply(values, index + 1, false);
                                    return;
                                }
                                const next = selects[index + 1];
                                const onReloaded = () => {
                                    next.removeEventListener('data-reloaded', onReloaded);
                                    apply(values, index + 1, true);
                                };
                                next.addEventListener('data-reloaded', onReloaded);
                                if (!equal) {
                                    select.tomselect !== undefined ? select.tomselect.setValue(values[index]) : (select.value = values[index], select.dispatchEvent(new Event('change', {bubbles: true})));
                                }
                            };

                            box.querySelectorAll('.happiness-combination').forEach((button) => {
                                button.addEventListener('click', () => {
                                    apply([button.dataset.customer, button.dataset.project, button.dataset.activity], 0, false);
                                });
                            });
                        })();
                    </script>
                {% endif %}
            {% endif %}
            {% if form.customer is defined %}
                {{ form_row(form.customer, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.customer.vars.name}}) }}
            {% endif %}
            {% if form.project is defined %}
                {{ form_row(form.project, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.project.vars.name}}) }}
            {% endif %}
            {% if form.activity is defined %}
                {{ form_row(form.activity, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.activity.vars.name}}) }}
            {% endif %}
            {% if form.description is defined %}
                {{ form_row(form.description, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.description.vars.name}}) }}
            {% endif %}
            {% if form.tags is defined %}
                {{ form_row(form.tags, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.tags.vars.name}}) }}
            {% endif %}
            {% if form.user is defined %}
                {{ form_row(form.user, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.user.vars.name}}) }}
            {% endif %}
            {% if form.users is defined %}
                {{ form_row(form.users, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.users.vars.name}}) }}
            {% endif %}
            {% if form.teams is defined %}
                {{ form_row(form.teams, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.teams.vars.name}}) }}
            {% endif %}
            {% if form.metaFields is defined and form.metaFields is not empty %}
                {% for meta in form.metaFields.children %}
                    {% if meta.vars.data.formTheme is not null %}
                        {% form_theme meta meta.vars.data.formTheme %}
                    {% endif %}
                {% endfor %}
                {{ form_row(form.metaFields) }}
            {% endif %}
            {% if form.fixedRate is defined or form.hourlyRate is defined or form.internalRate is defined or form.billable is defined or form.billableMode is defined or form.exported is defined %}
                {% embed '@theme/embeds/collapsible.html.twig' with {id: 'timesheet_extended_settings'} %}
                    {% import "macros/widgets.html.twig" as widgets %}
                    {% block title %}{{ 'extended_settings'|trans }}{% endblock %}
                    {% block body %}
                        {% if form.fixedRate is defined %}
                            {{ form_row(form.fixedRate, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.fixedRate.vars.name}}) }}
                        {% endif %}
                        {% if form.hourlyRate is defined %}
                            {{ form_row(form.hourlyRate, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.hourlyRate.vars.name}}) }}
                        {% endif %}
                        {% if form.internalRate is defined %}
                            {{ form_row(form.internalRate, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.internalRate.vars.name}}) }}
                        {% endif %}
                        {% if form.billable is defined %}
                            {{ form_row(form.billable, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.billable.vars.name}}) }}
                        {% elseif form.billableMode is defined %}
                            {{ form_row(form.billableMode, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.billableMode.vars.name}}) }}
                        {% endif %}
                        {% if form.exported is defined %}
                            {{ form_row(form.exported, {'row_attr': {'class': 'mb-3 ' ~ form.vars.name ~ '_row_' ~ form.exported.vars.name}}) }}
                        {% endif %}
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
