{% extends 'reporting/layout.html.twig' %}

{% macro hours(seconds) %}{{ ((seconds / 3600)|round(1)) ~ ' h' }}{% endmacro %}
{% import _self as macros %}

{% block report %}
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ project.name }}</h3>
                <div class="small text-muted">{{ project.customer.name }}</div>
            </div>
            <div class="card-actions">
                <a href="{{ path('happiness_active_projects', {week: week}) }}" class="btn">{{ 'back'|trans }}</a>
            </div>
        </div>
        <div class="card-body text-muted">
            {% if retainer_month is not null %}
                {{ 'happiness.active_projects.spent_retainer'|trans({'%month%': retainer_month|month_name(true), '%activity%': constant('KimaiPlugin\\HappinessBundle\\Service\\RetainerBalanceService::EXCLUDED_ACTIVITY')}, 'happiness') }}
            {% else %}
                {{ 'happiness.active_projects.spent_all_time'|trans({}, 'happiness') }}
            {% endif %}
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'date'|trans }}</th>
                        <th>{{ 'user'|trans }}</th>
                        <th>{{ 'activity'|trans }}</th>
                        <th>{{ 'description'|trans }}</th>
                        <th class="text-end">{{ 'duration'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for timesheet in timesheets %}
                    <tr>
                        <td class="text-nowrap">{{ timesheet.begin|date_short }}</td>
                        <td class="text-nowrap">{{ timesheet.user.displayName }}</td>
                        <td>{{ timesheet.activity.name ?? '' }}</td>
                        <td>{{ timesheet.description }}</td>
                        <td class="text-end text-nowrap">{{ timesheet.duration|duration }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">{{ 'error.no_entries_found'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4">{{ 'happiness.active_projects.spent'|trans({}, 'happiness') }}</th>
                        <th class="text-end text-nowrap">{{ macros.hours(total) }} ({{ total|duration }})</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
{% endblock %}
