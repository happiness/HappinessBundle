<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="sv" datatype="plaintext" original="happiness.sv.xlf">
    <body>
      <trans-unit id="report_happiness" resname="report_happiness">
        <source>report_happiness</source>
        <target>Happiness-rapport (per användare &amp; aktivitet)</target>
      </trans-unit>
      <trans-unit id="happiness.retainer.title" resname="happiness.retainer.title">
        <source>happiness.retainer.title</source>
        <target>Månatlig retainertimme</target>
      </trans-unit>
      <trans-unit id="happiness.retainer.enabled" resname="happiness.retainer.enabled">
        <source>happiness.retainer.enabled</source>
        <target>Aktivera automatisk månadsbokning</target>
      </trans-unit>
      <trans-unit id="happiness.retainer.day_of_month" resname="happiness.retainer.day_of_month">
        <source>happiness.retainer.day_of_month</source>
        <target>Dag i månaden för bokning (1-28)</target>
      </trans-unit>
      <trans-unit id="happiness.retainer.hours" resname="happiness.retainer.hours">
        <source>happiness.retainer.hours</source>
        <target>Antal timmar att boka</target>
      </trans-unit>
      <trans-unit id="happiness.retainer.description" resname="happiness.retainer.description">
        <source>happiness.retainer.description</source>
        <target>Beskrivning av bokningen</target>
      </trans-unit>
      <trans-unit id="happiness.retainer.user" resname="happiness.retainer.user">
        <source>happiness.retainer.user</source>
        <target>Användarnamn för användaren som bokar</target>
      </trans-unit>
      <trans-unit id="happiness.retainer.activity_id" resname="happiness.retainer.activity_id">
        <source>happiness.retainer.activity_id</source>
        <target>ID för aktiviteten som ska bokas på</target>
      </trans-unit>
      <trans-unit id="happiness.monthly_planning" resname="happiness.monthly_planning">
        <source>happiness.monthly_planning</source>
        <target>Planeringsarbete för månaden (%hours% h)</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.enabled" resname="happiness.retainer_balance.enabled">
        <source>happiness.retainer_balance.enabled</source>
        <target>Retainerprojekt (timsaldo)</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.hours" resname="happiness.retainer_balance.hours">
        <source>happiness.retainer_balance.hours</source>
        <target>Retainertimmar per månad</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.start" resname="happiness.retainer_balance.start">
        <source>happiness.retainer_balance.start</source>
        <target>Saldot startar i månad</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.start_help" resname="happiness.retainer_balance.start_help">
        <source>happiness.retainer_balance.start_help</source>
        <target>Saldot räknas från och med denna månad; krävs för att få ett saldo.</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.title" resname="happiness.retainer_balance.title">
        <source>happiness.retainer_balance.title</source>
        <target>Retainersaldo</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.month" resname="happiness.retainer_balance.month">
        <source>happiness.retainer_balance.month</source>
        <target>Månad</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.opening" resname="happiness.retainer_balance.opening">
        <source>happiness.retainer_balance.opening</source>
        <target>Ingående saldo</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.logged" resname="happiness.retainer_balance.logged">
        <source>happiness.retainer_balance.logged</source>
        <target>Registrerat</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.adjustment" resname="happiness.retainer_balance.adjustment">
        <source>happiness.retainer_balance.adjustment</source>
        <target>Ersätt ingående saldo</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.closing" resname="happiness.retainer_balance.closing">
        <source>happiness.retainer_balance.closing</source>
        <target>Saldo</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.no_start" resname="happiness.retainer_balance.no_start">
        <source>happiness.retainer_balance.no_start</source>
        <target>Ingen startmånad angiven på projektet</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.explanation" resname="happiness.retainer_balance.explanation">
        <source>happiness.retainer_balance.explanation</source>
        <target>%hours% timmar per månad sedan %start%. Saldot räknas fram från tidrapporterna, så ändringar där syns direkt. Tid på aktiviteten "Faktureras ej" räknas inte. Ingående saldo för en månad är föregående månads saldo. För att ersätta det, till exempel för att fakturera av ett underskott, skriv ett värde i fältet för månaden: det används då som ingående saldo från den månaden och framåt. Tomt fält betyder ingen ersättning, och 0 sätter saldot till noll.</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.adjust_invalid" resname="happiness.retainer_balance.adjust_invalid">
        <source>happiness.retainer_balance.adjust_invalid</source>
        <target>Ogiltig månad eller antal timmar.</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.text" resname="happiness.retainer_balance.text">
        <source>happiness.retainer_balance.text</source>
        <target>Text på tidrapporten till Fortnox</target>
      </trans-unit>
      <trans-unit id="happiness.retainer_balance.text_help" resname="happiness.retainer_balance.text_help">
        <source>happiness.retainer_balance.text_help</source>
        <target>Visas som första rad på tidrapporten till Fortnox. Lämna tomt för standardtexten. Variabler: {hours}, {logged}, {opening}, {adjustment}, {closing}, {month} (namnet på rapportens månad).</target>
      </trans-unit>
      <trans-unit id="happiness.suggestions.title" resname="happiness.suggestions.title">
        <source>happiness.suggestions.title</source>
        <target>Ofta använda</target>
      </trans-unit>
      <trans-unit id="report_active_projects" resname="report_active_projects">
        <source>report_active_projects</source>
        <target>Aktiva projekt</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.section.ongoing" resname="happiness.active_projects.section.ongoing">
        <source>happiness.active_projects.section.ongoing</source>
        <target>Löpande</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.section.fixed" resname="happiness.active_projects.section.fixed">
        <source>happiness.active_projects.section.fixed</source>
        <target>Fast pris / Projekt</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.section.retainer" resname="happiness.active_projects.section.retainer">
        <source>happiness.active_projects.section.retainer</source>
        <target>Retainers (fast månadssumma)</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.participants" resname="happiness.active_projects.participants">
        <source>happiness.active_projects.participants</source>
        <target>Projektdeltagare</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.estimated" resname="happiness.active_projects.estimated">
        <source>happiness.active_projects.estimated</source>
        <target>Beräknad tid</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.spent" resname="happiness.active_projects.spent">
        <source>happiness.active_projects.spent</source>
        <target>Nedlagd tid</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.remaining" resname="happiness.active_projects.remaining">
        <source>happiness.active_projects.remaining</source>
        <target>Kvar</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.overtime" resname="happiness.active_projects.overtime">
        <source>happiness.active_projects.overtime</source>
        <target>Mertid</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.saved" resname="happiness.active_projects.saved">
        <source>happiness.active_projects.saved</source>
        <target>Sparad tid</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.week" resname="happiness.active_projects.week">
        <source>happiness.active_projects.week</source>
        <target>Nedlagd tid i veckan</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.note" resname="happiness.active_projects.note">
        <source>happiness.active_projects.note</source>
        <target>Projektdeltagare är användare med tid på projektet de senaste %days% dagarna. Retainers visar månaden för vald vecka; sparad tid är saldot som förts in.</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.previous_week" resname="happiness.active_projects.previous_week">
        <source>happiness.active_projects.previous_week</source>
        <target>Föregående vecka</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.next_week" resname="happiness.active_projects.next_week">
        <source>happiness.active_projects.next_week</source>
        <target>Nästa vecka</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.this_week" resname="happiness.active_projects.this_week">
        <source>happiness.active_projects.this_week</source>
        <target>Denna vecka</target>
      </trans-unit>
      <trans-unit id="happiness.active_projects.week_number" resname="happiness.active_projects.week_number">
        <source>happiness.active_projects.week_number</source>
        <target>Vecka %week%, %year%</target>
      </trans-unit>
    </body>
